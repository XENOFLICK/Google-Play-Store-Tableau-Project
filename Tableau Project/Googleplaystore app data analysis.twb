      <aliases enabled='yes' />
      <column caption='App (googleplaystore user reviews.csv)' datatype='string' name='[App (googleplaystore_user_reviews.csv)]' role='dimension' type='nominal' />
      <column caption='Cleaned Rating' datatype='real' name='[Calculation_0681738309623808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([Rating]) OR FLOAT([Rating]) &gt; 5 THEN NULL ELSE FLOAT([Rating]) END' />
      </column>
      <column caption='Cleaned Size (MB)' datatype='real' name='[Calculation_0681738313424897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ENDSWITH([Size], &apos;M&apos;) THEN FLOAT(REPLACE([Size], &apos;M&apos;, &apos;&apos;))&#13;&#10;ELSEIF ENDSWITH([Size], &apos;k&apos;) THEN FLOAT(REPLACE([Size], &apos;k&apos;, &apos;&apos;)) / 1024&#13;&#10;ELSE NULL END' />
      </column>
      <column caption='Numerical Installs' datatype='integer' name='[Calculation_0681738318966786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(REGEXP_REPLACE(REGEXP_REPLACE([Installs], &apos;\+&apos;, &apos;&apos;), &apos;,&apos;, &apos;&apos;))' />
      </column>
      <column caption='Pricing Tiers' datatype='string' name='[Calculation_0681738344652805]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Type] = &apos;Free&apos; THEN &apos;Free Apps (0.00)&apos;&#13;&#10;ELSE &apos;Paid Apps (&gt;0.00)&apos;&#13;&#10;END' />
      </column>
      <column caption='App Price Brackets' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_0681738345431046]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Type] = &apos;Free&apos; THEN &apos;Free Apps&apos;&#13;&#10;ELSEIF [Reviews] &lt; 100 THEN &apos;$0.01 - $2.00 Tier&apos;&#13;&#10;ELSEIF [Reviews] &lt; 1000 THEN &apos;$2.01 - $5.00 Tier&apos;&#13;&#10;ELSEIF [Reviews] &lt; 10000 THEN &apos;$5.01 - $10.00 Tier&apos;&#13;&#10;ELSE &apos;Premium ($10+) Tier&apos;&#13;&#10;END' />
      </column>
      <column caption='Days Since Last Update' datatype='integer' name='[Calculation_0681738359971847]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Last Updated], {MAX([Last Updated])})' />
      </column>
      <column caption='Update Frequency Tiers' datatype='string' name='[Calculation_0681738361561096]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0681738359971847] &lt;= 30 THEN &apos;Updated inside 1 Month&apos;&#13;&#10;ELSEIF [Calculation_0681738359971847] &lt;= 90 THEN &apos;Updated 1 - 3 Months Ago&apos;&#13;&#10;ELSEIF [Calculation_0681738359971847] &lt;= 365 THEN &apos;Updated 3 - 12 Months Ago&apos;&#13;&#10;ELSE &apos;Stale (Over 1 Year Old)&apos;&#13;&#10;END' />
      </column>
      <column caption='Install Volume Brackets' datatype='string' name='[Calculation_0681738372296713]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0681738318966786] &lt;= 1000 THEN &apos;Micro Apps (&lt;1K)&apos;&#13;&#10;ELSEIF [Calculation_0681738318966786] &lt;= 50000 THEN &apos;Low-Scale Apps (1K - 50K)&apos;&#13;&#10;ELSEIF [Calculation_0681738318966786] &lt;= 500000 THEN &apos;Mid-Tier Volume (50K - 500K)&apos;&#13;&#10;ELSEIF [Calculation_0681738318966786] &lt;= 10000000 THEN &apos;Mass-Market Hits (500K - 10M)&apos;&#13;&#10;ELSE &apos;Global Giants (10M+)&apos;&#13;&#10;END' />
      </column>
      <column datatype='string' name='[Category]' role='dimension' type='nominal' />
      <column aggregation='None' caption='Cleaned Size (MB) (bin)' datatype='integer' name='[Cleaned Size (MB) (bin)]' role='dimension' type='ordinal'>
